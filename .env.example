# Local dev: matches the Docker Postgres started by `npm run db:up`.
# Production (Vercel): use Neon's POOLED connection URL (hostname contains
# `-pooler.{region}.neon.tech`). The direct endpoint will throttle.
DATABASE_URL=postgresql://qvuser:qvpassword@localhost:5433/qvdb

# Absolute URL used to build OG / Twitter card image URLs in metadata.
# Local dev: http://localhost:3030 (default for `npm run dev`).
# Production: your Vercel deployment origin, e.g. https://qvote.vercel.app
# or a custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3030
